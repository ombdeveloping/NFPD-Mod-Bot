BOT_TOKEN=
COMMAND_PREFIX=!
BRAND_NAME=NFPD Moderation
OWNER_IDS=123456789012345678,234567890123456789
GLOBAL_ACTION_ROLE_IDS=1525163441977950292
DATABASE_PATH=/data/moderation.db

# Servers global actions may run from and apply to. Strongly recommended.
# Leave empty and global actions hit every server the bot is in.
APPROVED_GUILD_IDS=

# Set to true to make the bot leave any server not listed above.
LEAVE_UNAPPROVED_GUILDS=false

# Users who can never be the target of a moderation action.
# Owners are always protected on top of this list.
PROTECTED_USER_IDS=

# Users who may not use the bot at all. Every command refuses for them.
BLOCKED_USER_IDS=
